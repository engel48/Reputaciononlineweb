# ===================================
# SUPABASE (REEMPLAZA SQLITE)
# ===================================

# Supabase Project Settings
# Dashboard: https://supabase.com/dashboard/project/YOUR_PROJECT_ID
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service Role Key (Admin operations - NEVER expose to client)
# Location: Dashboard → Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database URL (PostgreSQL)
# Location: Dashboard → Settings → Database → Connection String → URI
# Format: postgresql://postgres:[PASSWORD]@db.your-project-id.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-id.supabase.co:5432/postgres

# ===================================
# SISTEMA ANTIGUO (DEPRECADO - NO USAR)
# ===================================
# FORCE_SQLITE=true  # ❌ Ya no se usa - migrado a Supabase PostgreSQL
# DATABASE_URL_LOCAL=file:./data/app.db  # ❌ Ya no se usa - datos migrados a Supabase
# JWT_SECRET=reputacion-online-secret-key-2025  # ❌ Reemplazado por Supabase Auth
# NEXTAUTH_SECRET=your-nextauth-secret  # ❌ Reemplazado por Supabase Auth
# NEXTAUTH_URL=http://localhost:3000  # ❌ Reemplazado por Supabase Auth

# ===================================
# AMELIA IA (GEMINI API)
# ===================================
# Google AI Studio: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Legacy AI Services (opcional - Gemini es primario)
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ===================================
# PAGOS WOMPI (COLOMBIA)
# ===================================
# Dashboard Wompi: https://comercios.wompi.co/
# Modo Test (desarrollo)
WOMPI_PUBLIC_KEY=pub_test_your_public_key
WOMPI_PRIVATE_KEY=prv_test_your_private_key
WOMPI_EVENT_SECRET=your_event_secret_here

# Modo Producción (cuando estés listo)
# WOMPI_PUBLIC_KEY=pub_prod_your_public_key
# WOMPI_PRIVATE_KEY=prv_prod_your_private_key

NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_your_public_key

# ===================================
# OAUTH SOCIAL (CONFIGURAR EN SUPABASE DASHBOARD)
# ===================================
# Dashboard → Authentication → Providers

# Google OAuth
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook OAuth
# Developers: https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret

# Twitter/X OAuth
# Developer Portal: https://developer.twitter.com/
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

# LinkedIn OAuth
# Developer Portal: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Instagram Basic Display (via Facebook)
# Requires Facebook App with Instagram Basic Display enabled
INSTAGRAM_CLIENT_ID=your_instagram_app_id
INSTAGRAM_CLIENT_SECRET=your_instagram_app_secret

# YouTube (via Google)
# Uses same credentials as Google OAuth above
# Enable YouTube Data API v3 in Google Cloud Console

# Threads (via Instagram)
# Currently in beta - requires special access from Meta
THREADS_CLIENT_ID=your_threads_app_id
THREADS_CLIENT_SECRET=your_threads_app_secret

# ===================================
# EMAIL (RESEND)
# ===================================
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ===================================
# SCRAPING SERVICES (OPCIONAL)
# ===================================

# BrightData (formerly Luminati)
# Dashboard: https://brightdata.com/
BRIGHTDATA_API_KEY=your_brightdata_key

# ScrapingBee
# Dashboard: https://www.scrapingbee.com/
SCRAPINGBEE_API_KEY=your_scrapingbee_key

# Serper (Google Search API)
# Dashboard: https://serper.dev/
SERPER_API_KEY=your_serper_key

# ===================================
# ANALYTICS Y MONITORING
# ===================================

# Sentry (Error Tracking)
# Dashboard: https://sentry.io/
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# PostHog (Product Analytics)
# Dashboard: https://app.posthog.com/
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Plausible Analytics (Privacy-friendly)
# Dashboard: https://plausible.io/
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# ===================================
# DEPLOYMENT (AUTO-DETECTADO)
# ===================================
# Estas variables son auto-configuradas por las plataformas de hosting
# NO necesitas configurarlas manualmente

# Coolify
# COOLIFY_FQDN=reputaciononline.com

# Vercel
# VERCEL_URL=your-project.vercel.app

# Railway
# RAILWAY_STATIC_URL=your-project.railway.app

# ===================================
# DEVELOPMENT (LOCAL)
# ===================================
# Solo para desarrollo local
NODE_ENV=development
PORT=3000

# ===================================
# NOTAS IMPORTANTES
# ===================================
#
# 1. SUPABASE MIGRATION:
#    - Este proyecto migró de SQLite local a Supabase PostgreSQL
#    - Todas las variables DATABASE_URL_LOCAL, FORCE_SQLITE, JWT_SECRET están deprecadas
#    - Ahora usa NEXT_PUBLIC_SUPABASE_URL y autenticación de Supabase
#
# 2. CREDENCIALES REQUERIDAS MÍNIMAS:
#    - NEXT_PUBLIC_SUPABASE_URL
#    - NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - SUPABASE_SERVICE_ROLE_KEY
#    - DATABASE_URL (para Prisma)
#    - GEMINI_API_KEY (para Amelia IA)
#
# 3. OAUTH PROVIDERS:
#    - Configurar en Supabase Dashboard → Authentication → Providers
#    - Las credenciales aquí se copian al dashboard de Supabase
#    - Redirect URL: https://your-project-id.supabase.co/auth/v1/callback
#
# 4. SEGURIDAD:
#    - NUNCA commitear este archivo con valores reales
#    - Usar .env.local para valores reales (en .gitignore)
#    - SUPABASE_SERVICE_ROLE_KEY solo en servidor, nunca en cliente
#
# 5. DEPLOYMENT:
#    - Configurar todas estas variables en tu plataforma de hosting
#    - Coolify: Settings → Environment Variables
#    - Vercel: Settings → Environment Variables
#    - Railway: Variables tab
#
# 6. TESTING MIGRACIÓN:
#    npm run validate:supabase  # Valida que todo esté configurado
#    npm run health:supabase    # Verifica salud de servicios
#    npm run migrate:supabase   # Migra datos de SQLite (solo una vez)
